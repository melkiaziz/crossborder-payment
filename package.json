{
  "name": "crossborder-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "docker:up": "docker compose down --remove-orphans -t 5 && docker compose up --build",
    "docker:rebuild": "docker builder prune -f && docker compose build --no-cache && docker compose up",
    "docker:fix-modules": "docker compose down -t 5 && docker volume rm crossborder_frontend_node_modules crossborder_backend_node_modules crossborder_blockchain2_node_modules 2>nul || exit 0",
    "docker:down": "docker compose down --remove-orphans -t 5",
    "docker:clean": "docker compose down --remove-orphans -t 5 && docker rm -f crossborder-deployer 2>nul || exit 0",
    "docker:reset": "docker compose down -v --remove-orphans",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:crossborder-frontend": "node dist/crossborder-frontend/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.1.4",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "bcrypt": "^6.0.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "crypto": "^1.0.1",
    "ethers": "^6.16.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "ng2-charts": "^8.0.0",
    "nodemailer": "^8.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^20.17.19",
    "@types/nodemailer": "^7.0.11",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
